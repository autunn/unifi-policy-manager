<UserControl x:Class="UniFiDnsManager.OfficialApiWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760" MinHeight="520">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ModuleTitleText" Text="官方 API 工作台" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="ModuleDescriptionText" Text="使用 Ubiquiti 官方 Network Integration API。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,24,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="OperationCountText" Text="0 个官方操作" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="16,14,16,10">
                        <TextBlock Text="端点操作" FontWeight="Bold" FontSize="15"/>
                        <TextBox x:Name="OperationSearchTextBox" Margin="0,9,0,0" TextChanged="OperationSearchTextBox_TextChanged" ToolTip="搜索操作名称、方法或路径"/>
                    </StackPanel>
                    <ListBox x:Name="OperationListBox" Grid.Row="1" BorderThickness="0" SelectionChanged="OperationListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="8,2"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11,9" CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#EEF2FF" CornerRadius="5" Padding="5,3" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Method}" Foreground="#3730A3" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding PathTemplate}" Style="{StaticResource CaptionText}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#EEF2FF" CornerRadius="6" Padding="8,4"><TextBlock x:Name="MethodText" Text="GET" Foreground="#3730A3" FontWeight="Bold"/></Border>
                                <TextBlock x:Name="OperationTitleText" Text="选择一个官方操作" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="OperationDescriptionText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBlock x:Name="PathPreviewText" FontFamily="Consolas" Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="18,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="路径参数（每行 name=value）" FontWeight="SemiBold" FontSize="12"/>
                            <TextBox x:Name="PathParametersTextBox" Height="68" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="Consolas" Margin="0,6,0,0" TextChanged="RequestInput_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="QueryLabelText" Text="查询参数（不含 ?）" FontWeight="SemiBold" FontSize="12"/>
                            <TextBox x:Name="QueryTextBox" Height="68" AcceptsReturn="True" VerticalContentAlignment="Top" FontFamily="Consolas" Margin="0,6,0,0" TextChanged="RequestInput_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="18,0,18,12">
                        <Grid.RowDefinitions><RowDefinition x:Name="RequestHeaderRow" Height="Auto"/><RowDefinition x:Name="RequestBodyRow" Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid x:Name="RequestBodyHeader">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="请求体 JSON" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="格式化" Style="{StaticResource ToolbarButton}" Click="FormatRequestButton_Click"/>
                        </Grid>
                        <TextBox x:Name="RequestBodyTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,6,0,12"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="响应结果" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="复制结果" Style="{StaticResource ToolbarButton}" Click="CopyResponseButton_Click"/>
                        </Grid>
                        <TextBox x:Name="ResponseTextBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,6,0,0" Background="#F8FAFC"/>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExecutionHintText" Text="Site ID 会由当前站点自动填写。写操作执行前必须确认。" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                            <Button x:Name="ExecuteButton" Grid.Column="1" Content="执行官方请求" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="ExecuteButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

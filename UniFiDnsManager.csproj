<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UniFiDnsManager</RootNamespace>
    <AssemblyName>UniFi-Policy-Manager</AssemblyName>
    <Version>4.1.1</Version>
    <AssemblyVersion>4.1.1.0</AssemblyVersion>
    <FileVersion>4.1.1.0</FileVersion>
    <Product>UniFi Policy Manager</Product>
    <Company>Local Utility</Company>
    <Description>Official UniFi Network Integration API and policy manager</Description>
    <ApplicationIcon>Assets\UniFi.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\UniFi.ico" />
    <None Remove="Presets\unifi-forward-domains-by-service.csv" />
    <EmbeddedResource Include="Presets\unifi-forward-domains-by-service.csv"
                      LogicalName="UniFiDnsManager.Presets.unifi-forward-domains-by-service.csv" />
  </ItemGroup>
</Project>

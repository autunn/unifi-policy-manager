<Window x:Class="UniFiDnsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UniFiDnsManager"
        Title="UniFi Policy Manager" Width="1480" Height="930" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen" Icon="Assets/UniFi.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- 登录 -->
        <Grid x:Name="LoginPanel" Background="#F4F7FB">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Border Background="#0B1220">
                <Grid Margin="54">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="#2563EB" CornerRadius="10"><TextBlock Text="U" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="UniFi Policy Manager" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="OFFICIAL NETWORK API" Foreground="#60A5FA" FontSize="10" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="把复杂策略，变成可预览、可恢复的变更计划。" Foreground="White" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" LineHeight="48"/>
                        <TextBlock Text="集中管理策略，并覆盖 UniFi Network 官方 Integration API 的 44 条路径、73 个操作。敏感写操作执行前会显示最终请求并再次确认。" Foreground="#B5C2D4" FontSize="15" TextWrapping="Wrap" LineHeight="25" Margin="0,22,0,0"/>
                        <StackPanel Margin="0,34,0,0">
                            <TextBlock Text="✓  73 个官方 API 操作统一工作台" Foreground="#DCE7F5" FontSize="14" Margin="0,0,0,12"/>
                            <TextBlock Text="✓  DNS 全部 7 种记录批量管理" Foreground="#DCE7F5" FontSize="14" Margin="0,0,0,12"/>
                            <TextBlock Text="✓  API Key 使用 Windows DPAPI 加密" Foreground="#DCE7F5" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="UCG Fiber · Network API v10.4.57 compatible" Foreground="#71829B" FontSize="11"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardBorder}" Width="650" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="44" Padding="34">
                    <StackPanel>
                        <TextBlock Text="连接 UniFi Console" FontSize="27" FontWeight="Bold"/>
                        <TextBlock Text="使用本地地址和官方 API Key 读取策略。" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,7,0,0"/>

                        <TextBlock Text="UCG 地址" FontWeight="SemiBold" Margin="0,28,0,7"/>
                        <TextBox x:Name="HostTextBox" Text="192.168.1.1" FontSize="14"/>
                        <TextBlock Text="只填写 IP 或主机名，例如 192.168.1.1" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>

                        <TextBlock Text="API Key" FontWeight="SemiBold" Margin="0,20,0,7"/>
                        <PasswordBox x:Name="ApiKeyInput" FontSize="14"/>
                        <TextBlock Text="在 unifi.ui.com → Settings → API Keys 创建" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>

                        <StackPanel Margin="0,22,0,0">
                            <CheckBox x:Name="RememberApiKeyCheckBox" Content="记住 API Key（Windows 当前用户加密）" IsChecked="True"/>
                            <CheckBox x:Name="VerifyTlsCheckBox" Content="验证 UCG HTTPS 证书" Margin="0,12,0,0"/>
                        </StackPanel>

                        <Button Content="连接并读取策略" Style="{StaticResource PrimaryButton}" FontSize="14" Margin="0,26,0,0" Click="LoginButton_Click"/>
                        <Button x:Name="ForgetApiKeyButton" Content="清除本机保存的 API Key" Margin="0,10,0,0" Click="ForgetApiKeyButton_Click"/>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,24,0,0">
                            <TextBlock Text="程序不会通过聊天、日志或导出文件保存明文 API Key。" Foreground="#1E4F91" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- 工作台 -->
        <Grid x:Name="WorkspacePanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border x:Name="SidebarBorder" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="22,22,18,18">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="37" Height="37" Background="#2563EB" CornerRadius="9"><TextBlock Text="U" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="Policy Manager" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="OFFICIAL API" Foreground="#60A5FA" FontSize="9" FontWeight="Bold"/></StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer x:Name="SidebarScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                        <StackPanel>
                            <Expander x:Name="WorkspaceNavGroup" Header="工作台" Style="{StaticResource SidebarGroupExpander}" AutomationProperties.HelpText="独立展开或折叠工作台导航">
                                <StackPanel>
                                    <RadioButton x:Name="DashboardNavRadio" GroupName="Navigation" Tag="Overview" IsChecked="True" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="18" Width="28"/><TextBlock Text="概览" VerticalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ChangeCenterNavRadio" GroupName="Navigation" Tag="ChangeCenter" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="⇄" FontSize="18" Width="28"/><TextBlock Text="策略变更中心" VerticalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="NetworkResourcesNavGroup" Header="网络资源" Style="{StaticResource SidebarGroupExpander}" AutomationProperties.HelpText="独立展开或折叠网络资源导航">
                                <StackPanel>
                                    <RadioButton GroupName="Navigation" Tag="ApiDevices" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="◫" FontSize="17" Width="28"/><TextBlock Text="UniFi 设备" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="ApiClients" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="17" Width="28"/><TextBlock Text="在线客户端" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="ApiNetworks" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="⌘" FontSize="17" Width="28"/><TextBlock Text="网络" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="ApiWifi" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="◖" FontSize="17" Width="28"/><TextBlock Text="WiFi 广播" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="ApiHotspot" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="17" Width="28"/><TextBlock Text="Hotspot 凭证" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="PolicySecurityNavGroup" Header="策略与安全" Style="{StaticResource SidebarGroupExpander}" AutomationProperties.HelpText="独立展开或折叠策略与安全导航">
                                <StackPanel>
                                    <RadioButton x:Name="DnsNavRadio" GroupName="Navigation" Tag="Dns" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="◎" FontSize="17" Width="28"/><TextBlock x:Name="DnsTabHeaderText" Text="DNS 记录" VerticalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="Acl" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="17" Width="28"/><TextBlock x:Name="AclTabHeaderText" Text="ACL 规则" VerticalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="Firewall" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="17" Width="28"/><TextBlock x:Name="FirewallTabHeaderText" Text="防火墙策略" VerticalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="ApiFirewall" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="⬡" FontSize="16" Width="28"/><TextBlock Text="防火墙区域/API" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="ApiTraffic" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="≋" FontSize="18" Width="28"/><TextBlock Text="流量匹配列表" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="InfrastructureNavGroup" Header="基础设施与开发" Style="{StaticResource SidebarGroupExpander}" AutomationProperties.HelpText="独立展开或折叠基础设施与开发导航">
                                <StackPanel>
                                    <RadioButton GroupName="Navigation" Tag="ApiSwitching" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="⇆" FontSize="17" Width="28"/><TextBlock Text="交换与聚合" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="ApiResources" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="◌" FontSize="17" Width="28"/><TextBlock Text="WAN / VPN / 资源" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="ApiApplication" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" FontSize="17" Width="28"/><TextBlock Text="应用与站点" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                    <RadioButton GroupName="Navigation" Tag="ApiAll" Style="{StaticResource NavRadioButton}" Checked="NavigationRadio_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="API" FontSize="10" FontWeight="Bold" Width="28"/><TextBlock Text="全部官方端点" VerticalAlignment="Center"/></StackPanel></RadioButton>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#111C30" BorderBrush="#25344C" BorderThickness="1" CornerRadius="10" Padding="13" Margin="14,12,14,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#98A4B0" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="未连接" Foreground="#D8E2EF" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                            <TextBlock x:Name="SidebarSiteText" Text="尚未选择站点" Foreground="#7F91AA" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="25,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageTitleText" Text="策略概览" FontSize="22" FontWeight="Bold"/>
                            <TextBlock x:Name="PageSubtitleText" Text="查看当前站点的策略状态与最近操作。" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="刷新" Style="{StaticResource ToolbarButton}" Click="RefreshButton_Click"/>
                            <Button Content="导出基线" Style="{StaticResource ToolbarButton}" Click="ExportButton_Click"/>
                            <Button x:Name="UndoButton" Content="撤销 DNS 操作" IsEnabled="False" Style="{StaticResource ToolbarButton}" Click="UndoButton_Click"/>
                            <Button Content="断开" Style="{StaticResource ToolbarButton}" Click="LogoutButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24,20,24,22">
                    <!-- 概览 -->
                    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}" Background="#0F2A5F" BorderBrush="#0F2A5F" Padding="25" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="TargetText" Text="已连接" Foreground="White" FontSize="21" FontWeight="Bold"/>
                                        <TextBlock x:Name="SiteInfoText" Foreground="#C9D8ED" FontSize="12" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#183B78" CornerRadius="18" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="实时读取 · 官方 API" Foreground="#BFE7FF" FontSize="11" FontWeight="SemiBold"/></Border>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Style="{StaticResource StatCardBorder}" Margin="0,0,6,0"><StackPanel><TextBlock Text="全部策略" Style="{StaticResource CaptionText}"/><TextBlock x:Name="DashboardTotalCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="DNS + ACL + 防火墙" Foreground="#98A2B3" FontSize="11"/></StackPanel></Border>
                                <Border Style="{StaticResource StatCardBorder}" Margin="6,0"><StackPanel><TextBlock Text="DNS 记录" Style="{StaticResource CaptionText}"/><TextBlock x:Name="DashboardDnsCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="支持全部 7 种类型" Foreground="#98A2B3" FontSize="11"/></StackPanel></Border>
                                <Border Style="{StaticResource StatCardBorder}" Margin="6,0"><StackPanel><TextBlock Text="ACL 规则" Style="{StaticResource CaptionText}"/><TextBlock x:Name="DashboardAclCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="用户与系统规则" Foreground="#98A2B3" FontSize="11"/></StackPanel></Border>
                                <Border Style="{StaticResource StatCardBorder}" Margin="6,0,0,0"><StackPanel><TextBlock Text="防火墙策略" Style="{StaticResource CaptionText}"/><TextBlock x:Name="DashboardFirewallCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="含顺序与区域引用" Foreground="#98A2B3" FontSize="11"/></StackPanel></Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="推荐操作" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="先导出基线，再通过变更中心同步策略。" Style="{StaticResource CaptionText}" Margin="0,5,0,17"/>
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="15">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="策略变更中心" FontWeight="Bold" FontSize="15"/><TextBlock Text="导入备份，自动计算新增、更新、删除和不变项。" Style="{StaticResource CaptionText}" Margin="0,4,20,0"/></StackPanel><Button Grid.Column="1" Content="打开" Style="{StaticResource PrimaryButton}" Click="OpenChangeCenterButton_Click"/></Grid>
                                        </Border>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,10,0,0">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DNS 批量规则" FontWeight="Bold" FontSize="15"/><TextBlock Text="使用 CSV、TXT 或 XLSX 批量新增全部 DNS 类型。" Style="{StaticResource CaptionText}" Margin="0,4,20,0"/></StackPanel><Button Grid.Column="1" Content="管理 DNS" Click="OpenDnsButton_Click"/></Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="安全状态" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="本程序的写入保护" Style="{StaticResource CaptionText}" Margin="0,5,0,17"/>
                                        <TextBlock Text="●  每次修改前自动保存快照" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,13"/>
                                        <TextBlock Text="●  严格同步默认关闭" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,13"/>
                                        <TextBlock Text="●  系统与派生策略保持只读" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,13"/>
                                        <TextBlock Text="●  API Key 不写入备份或日志" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 策略变更中心 -->
                    <Grid x:Name="ChangeCenterPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,13">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="策略基线文件" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock x:Name="PlanSourceText" Text="尚未载入。可导入本程序导出的 JSON 基线或自动备份。" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,5,20,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="SynchronizeDeleteCheckBox" Content="严格同步（生成删除项）" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Checked="PlanMode_Changed" Unchecked="PlanMode_Changed"/>
                                    <Button x:Name="RestoreLastPlanButton" Content="载入上次快照" IsEnabled="False" Margin="18,0,0,0" Click="RestoreLastPlanButton_Click"/>
                                    <Button Content="载入 JSON" Margin="8,0,0,0" Click="LoadPolicyBundleButton_Click"/>
                                    <Button Content="导出当前基线" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="ExportButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,13">
                            <Border Style="{StaticResource StatCardBorder}" Margin="0,0,5,0"><StackPanel><TextBlock Text="新增" Style="{StaticResource CaptionText}"/><TextBlock x:Name="PlanAddCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource StatCardBorder}" Margin="5,0"><StackPanel><TextBlock Text="更新" Style="{StaticResource CaptionText}"/><TextBlock x:Name="PlanUpdateCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource StatCardBorder}" Margin="5,0"><StackPanel><TextBlock Text="删除" Style="{StaticResource CaptionText}"/><TextBlock x:Name="PlanDeleteCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource StatCardBorder}" Margin="5,0"><StackPanel><TextBlock Text="不变" Style="{StaticResource CaptionText}"/><TextBlock x:Name="PlanUnchangedCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource StatCardBorder}" Margin="5,0,0,0"><StackPanel><TextBlock Text="无效" Style="{StaticResource CaptionText}"/><TextBlock x:Name="PlanInvalidCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/></StackPanel></Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="变更明细" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="PlanSummaryText" Text="载入基线后显示差异。" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="选择安全变更" Click="SelectSafePlanItemsButton_Click"/><Button Content="选择全部（含删除）" Style="{StaticResource SoftDangerButton}" Margin="8,0,0,0" Click="SelectAllPlanItemsButton_Click"/><Button Content="清除选择" Margin="8,0,0,0" Click="ClearPlanSelectionButton_Click"/></StackPanel></Grid>
                                <DataGrid x:Name="ChangePlanGrid" Grid.Row="1" AutoGenerateColumns="False" SelectionMode="Extended" IsReadOnly="False">
                                    <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style><Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="执行" Binding="{Binding IsSelected, Mode=TwoWay}" Width="58"/>
                                        <DataGridTextColumn Header="范围" Binding="{Binding ScopeLabel}" Width="85" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="操作" Binding="{Binding ActionLabel}" Width="85" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="规则" Binding="{Binding Name}" Width="1.4*" IsReadOnly="True" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="变更内容" Binding="{Binding Details}" Width="2.5*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PlanSelectedText" Text="已选择 0 项。" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ApplyOrderingButton" Content="恢复基线排序" IsEnabled="False" Click="ApplyOrderingButton_Click"/><Button x:Name="ExecutePlanButton" Content="执行所选变更" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="8,0,0,0" Click="ExecutePlanButton_Click"/></StackPanel></Grid>
                    </Grid>

                    <!-- DNS -->
                    <Grid x:Name="DnsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Margin="20,16,20,13">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DNS 记录" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="选择记录类型后，列表、新增入口、数量与空状态会同步切换。" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                                        <TextBlock x:Name="DnsTotalCountText" Text="共 0 条记录" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <TabControl x:Name="DnsTypeTabs" Grid.Row="1" Style="{StaticResource SectionTabControl}" BorderThickness="0,1,0,0" SelectedIndex="0" SelectionChanged="DnsTypeTabs_SelectionChanged">
                                    <TabItem Tag="NS" Style="{StaticResource SectionTabItem}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="转发域名"/><Border Background="#DBEAFE" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"><TextBlock x:Name="NsCount" Text="0" FontSize="11" FontWeight="Bold"/></Border></StackPanel></TabItem.Header></TabItem>
                                    <TabItem Tag="A" Style="{StaticResource SectionTabItem}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="A"/><Border Background="#EEF2F7" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"><TextBlock x:Name="ACount" Text="0" FontSize="11" FontWeight="Bold"/></Border></StackPanel></TabItem.Header></TabItem>
                                    <TabItem Tag="AAAA" Style="{StaticResource SectionTabItem}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="AAAA"/><Border Background="#EEF2F7" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"><TextBlock x:Name="AaaaCount" Text="0" FontSize="11" FontWeight="Bold"/></Border></StackPanel></TabItem.Header></TabItem>
                                    <TabItem Tag="CNAME" Style="{StaticResource SectionTabItem}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="CNAME"/><Border Background="#EEF2F7" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"><TextBlock x:Name="CnameCount" Text="0" FontSize="11" FontWeight="Bold"/></Border></StackPanel></TabItem.Header></TabItem>
                                    <TabItem Tag="MX" Style="{StaticResource SectionTabItem}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="MX"/><Border Background="#EEF2F7" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"><TextBlock x:Name="MxCount" Text="0" FontSize="11" FontWeight="Bold"/></Border></StackPanel></TabItem.Header></TabItem>
                                    <TabItem Tag="TXT" Style="{StaticResource SectionTabItem}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="TXT"/><Border Background="#EEF2F7" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"><TextBlock x:Name="TxtCount" Text="0" FontSize="11" FontWeight="Bold"/></Border></StackPanel></TabItem.Header></TabItem>
                                    <TabItem Tag="SRV" Style="{StaticResource SectionTabItem}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="SRV"/><Border Background="#EEF2F7" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"><TextBlock x:Name="SrvCount" Text="0" FontSize="11" FontWeight="Bold"/></Border></StackPanel></TabItem.Header></TabItem>
                                </TabControl>
                            </Grid>
                        </Border>

                        <Expander Grid.Row="1" Margin="0,0,0,12">
                            <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="批量新增 DNS 规则" FontWeight="Bold" FontSize="15"/><TextBlock Text="  · CSV / TXT / XLSX" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/></StackPanel></Expander.Header>
                            <Border Style="{StaticResource CardBorder}" BorderBrush="#A5F3FC" Margin="0,8,0,0" Padding="17">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0"><TextBlock Text="转发域默认 DNS 服务器" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="BatchDnsServerTextBox"/><TextBlock Text="内置 212 条规则已封装在 EXE 中；连接后会尝试从现有转发域自动填充服务器。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0"/><Button x:Name="LoadBundledRulesButton" Content="载入内置规则（212）" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="LoadBundledRulesButton_Click"/><Button Content="选择外部规则文件" Margin="0,8,0,0" Click="ImportButton_Click"/><Button Content="保存 CSV 模板" Margin="0,8,0,0" Click="SaveCsvTemplateButton_Click"/><TextBlock x:Name="ImportSummaryText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,9,0,0"/><Button Content="预览并新增" Style="{StaticResource PrimaryButton}" Margin="0,13,0,0" Click="PreviewBatchAddButton_Click"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="DNS 规则清单" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="BatchRulesTextBox" Height="166" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" VerticalContentAlignment="Top"/></StackPanel>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,13,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="BatchDeleteSelectionText" Text="批量删除仍只作用于选中的转发域名。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="选择当前转发域" Click="SelectVisibleForwardDomainsButton_Click"/><Button Content="清除选择" Margin="8,0,0,0" Click="ClearBatchSelectionButton_Click"/><Button x:Name="BatchDeletePanelButton" Content="删除转发域 (0)" Style="{StaticResource SoftDangerButton}" IsEnabled="False" Margin="8,0,0,0" Click="BatchDeleteButton_Click"/></StackPanel></Grid></Border>
                                </Grid>
                            </Border>
                        </Expander>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CurrentDnsTypeTitle" Text="转发域名" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="RecordSummaryText" Style="{StaticResource CaptionText}"/><TextBlock x:Name="DnsTypeDescriptionText" Style="{StaticResource CaptionText}" Foreground="#2563EB" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="SearchTextBox" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextChanged="Filter_Changed" ToolTip="搜索当前记录类型"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BatchDeleteButton" Content="删除转发域 (0)" Style="{StaticResource SoftDangerButton}" IsEnabled="False" Click="BatchDeleteButton_Click"/><Button x:Name="AddDnsRecordButton" Content="新增转发域名" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="AddButton_Click"/></StackPanel></Grid>
                                <Grid Grid.Row="1">
                                    <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" MouseDoubleClick="RecordsGrid_MouseDoubleClick"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style><Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGrid.Resources><DataGrid.Columns>
                                        <DataGridTemplateColumn x:Name="BatchSelectColumn" Width="48"><DataGridTemplateColumn.Header><CheckBox x:Name="SelectAllCheckBox" Click="SelectAllCheckBox_Click"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelectedForBatch, Mode=TwoWay}" Click="BatchSelectionCheckBox_Click"><CheckBox.Style><Style TargetType="CheckBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsForwardDomain}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="85"/><DataGridTextColumn Header="域名" Binding="{Binding Key}" Width="2*" FontWeight="SemiBold"/><DataGridTextColumn Header="值 / 服务器" Binding="{Binding Value}" Width="2*"/><DataGridTextColumn Header="附加参数" Binding="{Binding ExtraLabel}" Width="1.4*"/>
                                        <DataGridTemplateColumn Header="操作" Width="205"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="启/停" Tag="{Binding}" Style="{StaticResource IconButton}" Click="ToggleRowButton_Click"/><Button Content="编辑" Tag="{Binding}" Style="{StaticResource IconButton}" Margin="5,0,0,0" Click="EditRowButton_Click"/><Button Content="删除" Tag="{Binding}" Style="{StaticResource IconButton}" Foreground="{StaticResource DangerBrush}" Margin="5,0,0,0" Click="DeleteRowButton_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns></DataGrid>
                                    <Border x:Name="DnsEmptyState" Background="#FAFCFF" Visibility="Collapsed" IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"><TextBlock Text="◎" FontSize="34" Foreground="#94A3B8" HorizontalAlignment="Center"/><TextBlock x:Name="DnsEmptyStateTitle" Text="还没有转发域名" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/><TextBlock x:Name="DnsEmptyStateDescription" Text="可新增一条记录，或使用上方批量操作面板导入规则。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ACL -->
                    <Border x:Name="AclPage" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="20,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACL 规则" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="AclSummaryText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel><TextBox x:Name="AclSearchTextBox" Grid.Column="1" Margin="10,0" TextChanged="PolicyFilter_Changed"/><Button Grid.Column="2" Content="新增 ACL 规则" Style="{StaticResource PrimaryButton}" Click="AddAclButton_Click"/></Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#F8FAFC" Margin="20,10">
                                <RadioButton x:Name="AclAllSegment" GroupName="AclOrigin" Tag="ALL" Content="全部 0" IsChecked="True" Style="{StaticResource SegmentRadioButton}" Checked="PolicyOriginFilter_Changed"/>
                                <RadioButton x:Name="AclUserSegment" GroupName="AclOrigin" Tag="USER" Content="用户定义 0" Style="{StaticResource SegmentRadioButton}" Checked="PolicyOriginFilter_Changed"/>
                                <RadioButton x:Name="AclSystemSegment" GroupName="AclOrigin" Tag="SYSTEM" Content="系统与派生 0" Style="{StaticResource SegmentRadioButton}" Checked="PolicyOriginFilter_Changed"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <DataGrid x:Name="AclGrid" AutoGenerateColumns="False" MouseDoubleClick="AclGrid_MouseDoubleClick"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGrid.Resources><DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="55"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="85"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="85"/><DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="85"/><DataGridTextColumn Header="来源" Binding="{Binding OriginLabel}" Width="95"/><DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="1.6*"/>
                                    <DataGridTemplateColumn Header="操作" Width="300"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="↑" Tag="{Binding}" Style="{StaticResource IconButton}" IsEnabled="{Binding CanModify}" Click="MovePolicyUp_Click"/><Button Content="↓" Tag="{Binding}" Style="{StaticResource IconButton}" Margin="4,0,0,0" IsEnabled="{Binding CanModify}" Click="MovePolicyDown_Click"/><Button Content="启/停" Tag="{Binding}" Style="{StaticResource IconButton}" Margin="7,0,0,0" IsEnabled="{Binding CanModify}" Click="TogglePolicy_Click"/><Button Content="编辑" Tag="{Binding}" Style="{StaticResource IconButton}" Margin="4,0,0,0" IsEnabled="{Binding CanModify}" Click="EditPolicy_Click"/><Button Content="删除" Tag="{Binding}" Style="{StaticResource IconButton}" Margin="4,0,0,0" Foreground="{StaticResource DangerBrush}" IsEnabled="{Binding CanModify}" Click="DeletePolicy_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns></DataGrid>
                                <Border x:Name="AclEmptyState" Background="#FAFCFF" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◇" FontSize="34" Foreground="#94A3B8" HorizontalAlignment="Center"/><TextBlock Text="当前筛选没有 ACL 规则" FontSize="17" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="切换上方来源分段，或调整搜索条件。" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 防火墙 -->
                    <Border x:Name="FirewallPage" Visibility="Collapsed" Style="{StaticResource CardBorder}" Padding="0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="20,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="防火墙策略" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="FirewallSummaryText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel><TextBox x:Name="FirewallSearchTextBox" Grid.Column="1" Margin="10,0" TextChanged="PolicyFilter_Changed"/><Button Grid.Column="2" Content="新增防火墙策略" Style="{StaticResource PrimaryButton}" Click="AddFirewallButton_Click"/></Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#F8FAFC" Margin="20,10">
                                <RadioButton x:Name="FirewallAllSegment" GroupName="FirewallOrigin" Tag="ALL" Content="全部 0" IsChecked="True" Style="{StaticResource SegmentRadioButton}" Checked="PolicyOriginFilter_Changed"/>
                                <RadioButton x:Name="FirewallUserSegment" GroupName="FirewallOrigin" Tag="USER" Content="用户定义 0" Style="{StaticResource SegmentRadioButton}" Checked="PolicyOriginFilter_Changed"/>
                                <RadioButton x:Name="FirewallSystemSegment" GroupName="FirewallOrigin" Tag="SYSTEM" Content="系统与派生 0" Style="{StaticResource SegmentRadioButton}" Checked="PolicyOriginFilter_Changed"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <DataGrid x:Name="FirewallGrid" AutoGenerateColumns="False" MouseDoubleClick="FirewallGrid_MouseDoubleClick"><DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGrid.Resources><DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="55"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="85"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/><DataGridTextColumn Header="IP" Binding="{Binding Type}" Width="105"/><DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="85"/><DataGridTextColumn Header="来源" Binding="{Binding OriginLabel}" Width="95"/><DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="1.6*"/>
                                    <DataGridTemplateColumn Header="操作" Width="300"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="↑" Tag="{Binding}" Style="{StaticResource IconButton}" IsEnabled="{Binding CanModify}" Click="MovePolicyUp_Click"/><Button Content="↓" Tag="{Binding}" Style="{StaticResource IconButton}" Margin="4,0,0,0" IsEnabled="{Binding CanModify}" Click="MovePolicyDown_Click"/><Button Content="启/停" Tag="{Binding}" Style="{StaticResource IconButton}" Margin="7,0,0,0" IsEnabled="{Binding CanModify}" Click="TogglePolicy_Click"/><Button Content="编辑" Tag="{Binding}" Style="{StaticResource IconButton}" Margin="4,0,0,0" IsEnabled="{Binding CanModify}" Click="EditPolicy_Click"/><Button Content="删除" Tag="{Binding}" Style="{StaticResource IconButton}" Margin="4,0,0,0" Foreground="{StaticResource DangerBrush}" IsEnabled="{Binding CanModify}" Click="DeletePolicy_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns></DataGrid>
                                <Border x:Name="FirewallEmptyState" Background="#FAFCFF" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="▣" FontSize="34" Foreground="#94A3B8" HorizontalAlignment="Center"/><TextBlock Text="当前筛选没有防火墙策略" FontSize="17" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="切换上方来源分段，或调整搜索条件。" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Official Network API workspace -->
                    <local:OfficialApiWorkspace x:Name="OfficialApiPage" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,4"><TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}"/></StatusBar>

        <Border x:Name="BusyOverlay" Grid.RowSpan="2" Background="#990B1220" Visibility="Collapsed">
            <Border Background="White" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><ProgressBar IsIndeterminate="True" Width="120" Height="8"/><TextBlock x:Name="BusyText" Text="处理中…" Margin="15,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
